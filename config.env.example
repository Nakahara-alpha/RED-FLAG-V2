# ── 𝑅𝛯𝐷 𝐹𝐿𝛥𝐺 V2 — config template ──────────────────────────────
# Copy this to `config.env` and fill it in, OR set these as environment
# variables in your host's panel (panel env vars win over config.env).
# Only OWNER_NUMBER + a login method are strictly required to boot.

PREFIX=.
BOT_NAME=𝐵𝑌 𝑅𝛯𝐷 𝐹𝐿𝛥𝐺 V2
OWNER_NUMBER=
OWNER_NAME=RED FLAG

# ── Login (pick ONE, or leave both empty for QR in the terminal) ──
SESSION_ID=
PAIRING_NUMBER=

ALWAYS_ONLINE=false
TZ_OFFSET_MIN=60

# Ephemeral media cache: retention (minutes) + storage cap (MB)
MEDIA_RETENTION_MIN=15
MEDIA_CAP_MB=500

# AI (get free keys: console.groq.com | aistudio.google.com)
# Gemini is PRIMARY. Give one or several keys (comma-separated here or in
# GEMINI_API_KEYS) to spread rate limits. Falls back to AgentRouter, then Groq.
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Gemini model id (default gemini-3.8-flash). Override if Google retires it.
GEMINI_MODEL=gemini-3.8-flash
# Keep replies FAST: low = minimal thinking (default, snappy), high = deliberate,
# off = don't send the thinking field at all. Flash stays smart on low.
GEMINI_THINKING=low

# AgentRouter (agentrouter.org) — primary AI + NEXUS. Key: agentrouter.org/console/token
# Default model is a DeepSeek V3 (reliably available + supports NEXUS tool-calling).
# Check your key's real model ids with `.aimodel list`.
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=deepseek-v3.2
AGENTROUTER_VISION_MODEL=
AGENTROUTER_BASE_URL=
AI_TIMEOUT_MS=30000
# NEXUS tool-calling rounds take longer than a plain chat (the model thinks,
# calls a tool, thinks again). Deadline per agent step, ms. Default 60000.
NEXUS_TIMEOUT_MS=60000
# Optional: override NEXUS's personality/voice (one line). Blank = default (sharp,
# loyal, a little cheeky). The owner can also just type "nexus <message>" with no
# prefix to talk to it naturally; change that wake-word with NEXUS_WAKE.
NEXUS_PERSONA=
NEXUS_WAKE=nexus

STICKER_PACKNAME=𝐵𝑌 𝑅𝛯𝐷 𝐹𝐿𝛥𝐺
WARN_LIMIT=3

DIGEST_TIME=06:30
WEATHER_CITY=Lagos
NEWS_EDITION=en-NG:en:NG
PQ_DIR=

# Optional YouTube cookie for .play/.yt on datacenter hosts (JSON array or
# "name=value; name=value" string).
YT_COOKIE=

# IoT / ESP32 (MQTT) — requires: npm i mqtt
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=redflag

# External Nexus relay (the .relay command). NOT the .nexus AI assistant.
NEXUS_API_URL=
